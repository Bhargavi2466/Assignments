class Solution {

    static int min, max;

    static void findMinMax(int[] arr, int index) {
        if (index == arr.length) {
            return;
        }

        if (arr[index] < min) {
            min = arr[index];
        }

        if (arr[index] > max) {
            max = arr[index];
        }

        findMinMax(arr, index + 1);
    }

    public static int[] getMinMax(int[] arr) {
        min = arr[0];
        max = arr[0];

        findMinMax(arr, 1);

        return new int[]{min, max};
    }
}
